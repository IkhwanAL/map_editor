package ui

templ SidebarPage() {
	<div class="sidebar-area">
		<div class="tools" id="toolbar">
			<button class="tool" id="draw-map" data-tool="draw-map">Draw Map Tool</button>
			<button class="tool" id="brush" data-tool="brush">Brush Tools</button>
		</div>
		<div class="tool-config">
			<div id="draw-map-tool" hidden data-button="draw-map"><draw-map-tool></draw-map-tool></div>
			<div id="brush-tool" hidden data-button="brush"></div>
		</div>
	</div>
}
