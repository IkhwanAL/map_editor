package ui

templ SidebarPage() {
	<div class="sidebar-area">
		<div class="tools" id="toolbar">
			<button class="tool" id="brush" data-tool="brush-tool">Brush Tools</button>
		</div>
		<div class="tool-config">
			<div id="brush-tool" hidden data-button="brush"><brush-tool></brush-tool></div>
		</div>
	</div>
}
